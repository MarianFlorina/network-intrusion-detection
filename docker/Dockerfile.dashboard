# Streamlit security dashboard: reads aggregates from PostgreSQL and
# status from the FastAPI /health/model endpoint.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-dashboard.txt /tmp/requirements-dashboard.txt
RUN pip install --no-cache-dir -r /tmp/requirements-dashboard.txt

COPY dashboard ./dashboard
COPY config ./config
COPY src/__init__.py ./src/__init__.py

EXPOSE 8501
CMD ["streamlit", "run", "dashboard/app.py", "--server.port=8501", "--server.address=0.0.0.0"]
