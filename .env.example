# ===== Copy to .env and adjust =====
# All services share these via docker-compose.yml

# --- Database (PostgreSQL) ---
POSTGRES_USER=nad_user
POSTGRES_PASSWORD=nad_password
POSTGRES_DB=network_ids
POSTGRES_HOST=postgres          # use "localhost" when running outside Docker
POSTGRES_PORT=5432

# --- MLflow ---
MLFLOW_TRACKING_URI=http://mlflow:5000   # use http://localhost:5000 outside Docker
MLFLOW_BACKEND_STORE_URI=postgresql://nad_user:nad_password@postgres:5432/network_ids
MLFLOW_ARTIFACT_ROOT=/mlartifacts

# --- Airflow ---
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Streamlit ---
STREAMLIT_SERVER_PORT=8501
